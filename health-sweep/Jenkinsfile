// Pipeline 1: Container Health Sweep
// Checks all containers for unhealthy/restarting status and excessive restart counts.
// Requires: Docker CLI on agent PATH, Bun runtime, slack-webhook-docker-alerts credential.
pipeline {
    agent any

    options {
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    // CRON_SCHEDULE drives the trigger — change param + save job to reschedule.
    // Elvis operator guards against NPE on the very first build (params not yet populated).
    triggers {
        cron(params.CRON_SCHEDULE ?: '')
    }

    parameters {
        string(
            name: 'CRON_SCHEDULE',
            defaultValue: 'H/15 * * * *',
            description: 'Cron expression (e.g. "H/15 * * * *"). Set to empty string to pause scheduling.'
        )
        string(
            name: 'RESTART_THRESHOLD',
            defaultValue: '5',
            description: 'Alert if a container RestartCount is >= this value.'
        )
        booleanParam(
            name: 'INCLUDE_STOPPED',
            defaultValue: true,
            description: 'Include stopped (Exited) containers in the sweep.'
        )
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: false,
            description: 'When checked, logs findings but does not send Slack alerts or write reports.'
        )
    }

    environment {
        RESTART_THRESHOLD     = "${params.RESTART_THRESHOLD}"
        INCLUDE_STOPPED       = "${params.INCLUDE_STOPPED}"
        DRY_RUN               = "${params.DRY_RUN}"
    }

    stages {
        stage('Validate Environment') {
            steps {
                script {
                    sh '''
                        set -e
                        echo "=== Runtime check ==="
                        bun --version || { echo "ERROR: bun not found on PATH"; exit 1; }
                        docker --version || { echo "ERROR: docker not found on PATH"; exit 1; }
                        docker info > /dev/null 2>&1 || { echo "ERROR: Docker daemon is not reachable"; exit 1; }
                        echo "Environment OK"
                    '''
                }
            }
        }

        stage('Install') {
            steps {
                sh 'bun install --frozen-lockfile'
            }
        }

stage('Sweep Containers') {
            steps {
                script {
def exitCode = sh(
                        script: 'bun run health-sweep',
                        returnStatus: true
                    )
                    
                    // Get issue count for Slack
                    def issueCount = sh(
                        script: 'cat health-report.json | jq -r \'.issues | length\' 2>/dev/null || echo "0"',
                        returnStdout: true
                    ).trim()
                    
                    if (exitCode == 2) {
                        currentBuild.result      = 'UNSTABLE'
                        currentBuild.description = "Issues found — ${env.BUILD_NUMBER} (${issueCount} issues)"
                    } else if (exitCode != 0) {
                        currentBuild.description = "Sweep crashed (exit ${exitCode})"
                        error("health-sweep exited with code ${exitCode}")
                    } else {
                        currentBuild.description = "All containers healthy"
                    }
                }
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts(
                    artifacts: 'health-report.json',
                    allowEmptyArchive: true,
                    fingerprint: false
                )
            }
        }

        stage('Notify') {
            when {
                allOf {
                    expression { params.DRY_RUN == false }
                    expression { currentBuild.result == 'UNSTABLE' }
                }
            }
            steps {
                script {
                    withCredentials([string(credentialsId: 'slack-webhook-docker-alerts', variable: 'SLACK_WEBHOOK_URL')]) {
                        if (env.SLACK_WEBHOOK_URL) {
                            // Get issue details using jq
                            def issuesDetails = sh(
                                script: 'cat health-report.json | jq -r \'.issues[] | "• \\(.name): \\(.classification)"\' 2>/dev/null || echo "Check archived report"',
                                returnStdout: true
                            ).trim()
                            def msg = "⚠️ Docker Health Sweep — issues detected on build #${env.BUILD_NUMBER}\n\n${issuesDetails}"
                            sh """
                                curl -s -X POST -H 'Content-Type: application/json' \
                                    -d '{"text":"${msg}","attachments":[{"color":"#FFA500","text":"${msg}"}]}' \
                                    "${env.SLACK_WEBHOOK_URL}" || true
                            """
                        }
                    }
                }
            }
        }
                }
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts(
                    artifacts: 'health-report.json',
                    allowEmptyArchive: true,
                    fingerprint: false
                )
            }
        }

        stage('Notify') {
            when {
                allOf {
                    expression { params.DRY_RUN == false }
                    expression { currentBuild.result == 'UNSTABLE' }
                }
            }
            steps {
                script {
                    withCredentials([string(credentialsId: 'slack-webhook-docker-alerts', variable: 'SLACK_WEBHOOK_URL')]) {
                        if (env.SLACK_WEBHOOK_URL) {
                            def msg = "⚠️ Docker Health Sweep — issues detected on build #${env.BUILD_NUMBER}\n\n${env.ISSUES_TEXT}"
                            sh """
                                curl -s -X POST -H 'Content-Type: application/json' \
                                    -d '{"text":"${msg}","attachments":[{"color":"#FFA500","text":"${msg}"}]}' \
                                    "${env.SLACK_WEBHOOK_URL}" || true
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        failure {
            script {
                withCredentials([string(credentialsId: 'slack-webhook-docker-alerts', variable: 'SLACK_WEBHOOK_URL')]) {
                    if (!params.DRY_RUN && env.SLACK_WEBHOOK_URL) {
                        def msg = "🔴 Docker Health Sweep FAILED on build #${env.BUILD_NUMBER}."
                        sh """
                            curl -s -X POST -H 'Content-Type: application/json' \
                                -d '{"text":"${msg}","attachments":[{"color":"#FF0000","text":"${msg}"}]}' \
                                "${env.SLACK_WEBHOOK_URL}" || true
                        """
                    }
                }
            }
        }
        always {
            // Skip cleanup to avoid plugin issues
            echo "Build completed"
        }
    }
}
