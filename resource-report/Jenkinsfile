// Pipeline 2: Resource Usage Report
// Measures per-container CPU and memory usage against configurable thresholds.
// Requires: Docker CLI on agent PATH, Bun runtime, slack-webhook-docker-alerts credential.
pipeline {
    agent {
        label 'PLACEHOLDER_LINUX_AGENT'
    }

    options {
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timestamps()
    }

    triggers {
        cron(params.CRON_SCHEDULE ?: '')
    }

    parameters {
        string(
            name: 'CRON_SCHEDULE',
            defaultValue: 'H * * * *',
            description: 'Cron expression (e.g. "H * * * *"). Set to empty string to pause scheduling.'
        )
        string(
            name: 'CPU_THRESHOLD_PCT',
            defaultValue: '80',
            description: 'Alert if container CPU% >= this value (0–100).'
        )
        string(
            name: 'MEM_THRESHOLD_PCT',
            defaultValue: '85',
            description: 'Alert if container Memory% >= this value (0–100).'
        )
        string(
            name: 'CONTAINER_FILTER',
            defaultValue: '',
            description: 'Optional: only check containers whose name starts with this prefix. Leave blank to check all.'
        )
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: true,
            description: 'When checked, logs findings but does not send Slack alerts.'
        )
    }

    environment {
        SLACK_WEBHOOK_URL = credentials('slack-webhook-docker-alerts')
        CPU_THRESHOLD_PCT = "${params.CPU_THRESHOLD_PCT}"
        MEM_THRESHOLD_PCT = "${params.MEM_THRESHOLD_PCT}"
        CONTAINER_FILTER  = "${params.CONTAINER_FILTER}"
        DRY_RUN           = "${params.DRY_RUN}"
        BUILD_NUMBER      = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Validate Environment') {
            steps {
                script {
                    sh '''
                        set -e
                        bun --version || { echo "ERROR: bun not found on PATH"; exit 1; }
                        docker --version || { echo "ERROR: docker not found on PATH"; exit 1; }
                        docker info > /dev/null 2>&1 || { echo "ERROR: Docker daemon is not reachable"; exit 1; }

                        cpu="${CPU_THRESHOLD_PCT:-80}"
                        mem="${MEM_THRESHOLD_PCT:-85}"
                        if [ "$cpu" -lt 0 ] || [ "$cpu" -gt 100 ]; then
                            echo "ERROR: CPU_THRESHOLD_PCT must be 0-100, got $cpu"; exit 1
                        fi
                        if [ "$mem" -lt 0 ] || [ "$mem" -gt 100 ]; then
                            echo "ERROR: MEM_THRESHOLD_PCT must be 0-100, got $mem"; exit 1
                        fi
                        echo "Environment OK"
                    '''
                }
            }
        }

        stage('Install') {
            steps {
                sh 'bun install --frozen-lockfile'
            }
        }

        stage('Collect Stats') {
            steps {
                script {
                    def exitCode = sh(
                        script: 'bun run resource-report',
                        returnStatus: true
                    )
                    if (exitCode == 2) {
                        currentBuild.result      = 'UNSTABLE'
                        currentBuild.description = "Threshold breach(es) — build #${env.BUILD_NUMBER}"
                    } else if (exitCode != 0) {
                        currentBuild.description = "Crashed (exit ${exitCode})"
                        error("resource-report exited with code ${exitCode}")
                    } else {
                        currentBuild.description = "All containers within thresholds"
                    }
                }
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts(
                    artifacts: "resource-report-${env.BUILD_NUMBER}.json",
                    allowEmptyArchive: true,
                    fingerprint: false
                )
            }
        }

        stage('Notify') {
            when {
                allOf {
                    expression { params.DRY_RUN == false }
                    expression { currentBuild.result == 'UNSTABLE' }
                }
            }
            steps {
                script {
                    def msg = "⚠️ Docker Resource Report — threshold breach(es) on build #${env.BUILD_NUMBER}."
                    sh """
                        curl -s -X POST -H 'Content-Type: application/json' \
                            -d '{"text":"${msg}","attachments":[{"color":"#FFA500","text":"${msg}"}]}' \
                            "\$SLACK_WEBHOOK_URL" || true
                    """
                }
            }
        }
    }

    post {
        failure {
            script {
                if (!params.DRY_RUN) {
                    def msg = "🔴 Docker Resource Report FAILED on build #${env.BUILD_NUMBER}."
                    sh """
                        curl -s -X POST -H 'Content-Type: application/json' \
                            -d '{"text":"${msg}","attachments":[{"color":"#FF0000","text":"${msg}"}]}' \
                            "\$SLACK_WEBHOOK_URL" || true
                    """
                }
            }
        }
        always {
            cleanWs()
        }
    }
}
