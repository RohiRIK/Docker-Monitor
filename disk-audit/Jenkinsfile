// Pipeline 3: Disk Cleanup Audit
// Identifies reclaimable disk space: dangling images, anonymous volumes, build cache.
// AUDIT ONLY — this pipeline never executes docker prune, docker rm, or docker rmi.
// Requires: Docker CLI on agent PATH, Bun runtime, slack-webhook-docker-alerts credential.
pipeline {
    agent any

    options {
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    triggers {
        cron(params.CRON_SCHEDULE ?: '')
    }

    parameters {
        string(
            name: 'CRON_SCHEDULE',
            defaultValue: 'H 6 * * *',
            description: 'Cron expression (e.g. "H 6 * * *"). Set to empty string to pause scheduling.'
        )
        string(
            name: 'DANGLING_IMAGE_AGE_DAYS',
            defaultValue: '7',
            description: 'Flag dangling images older than this many days as prune candidates.'
        )
        string(
            name: 'VOLUME_SIZE_MB_THRESHOLD',
            defaultValue: '500',
            description: 'Flag anonymous volumes larger than this many MB as prune candidates.'
        )
        string(
            name: 'REPORT_TOP_N',
            defaultValue: '10',
            description: 'Number of largest candidates to include in the report (1–100).'
        )
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: true,
            description: 'Always true — disk audit never prunes. This param exists for UI clarity only.'
        )
    }

    environment {
        DANGLING_IMAGE_AGE_DAYS  = "${params.DANGLING_IMAGE_AGE_DAYS}"
        VOLUME_SIZE_MB_THRESHOLD = "${params.VOLUME_SIZE_MB_THRESHOLD}"
        REPORT_TOP_N             = "${params.REPORT_TOP_N}"
        DRY_RUN                  = 'true'
    }

    stages {
        stage('Validate Environment') {
            steps {
                script {
                    sh '''
                        set -e
                        echo "=== Runtime check ==="
                        /usr/local/bin/bun --version || { echo "ERROR: bun not found on PATH"; exit 1; }
                        docker --version || { echo "ERROR: docker not found on PATH"; exit 1; }
                        docker info > /dev/null 2>&1 || { echo "ERROR: Docker daemon is not reachable"; exit 1; }
                        echo "Environment OK"
                    '''
                }
            }
        }

        stage('Install') {
            steps {
                sh '/usr/local/bin/bun install --frozen-lockfile'
            }
        }

        stage('Audit Disk Usage') {
            steps {
                script {
                    sh '/usr/local/bin/bun run disk-audit'
                    currentBuild.description = "Audit complete — build #${env.BUILD_NUMBER}"
                }
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts(
                    artifacts: "disk-audit-${env.BUILD_NUMBER}.json",
                    allowEmptyArchive: true,
                    fingerprint: false
                )
            }
        }

        stage('Notify') {
            steps {
                script {
                    withCredentials([string(credentialsId: 'slack-webhook-docker-alerts', variable: 'SLACK_WEBHOOK_URL')]) {
                        if (env.SLACK_WEBHOOK_URL) {
                            def currentDate = new Date().format("yyyy-MM-dd HH:mm")
                            def msg = "📦 Docker Disk Audit complete — build #${env.BUILD_NUMBER}\n📅 ${currentDate}"
                            sh """
                                curl -s -X POST -H 'Content-Type: application/json' \
                                    -d '{"text":"${msg}","attachments":[{"color":"#36A64F","text":"Check archived report for reclaimable candidates."}]}' \
                                    "${env.SLACK_WEBHOOK_URL}" || true
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        failure {
            script {
                withCredentials([string(credentialsId: 'slack-webhook-docker-alerts', variable: 'SLACK_WEBHOOK_URL')]) {
                    if (env.SLACK_WEBHOOK_URL) {
                        def currentDate = new Date().format("yyyy-MM-dd HH:mm")
                        def msg = "🔴 Docker Disk Audit FAILED on build #${env.BUILD_NUMBER}\n📅 ${currentDate}"
                        sh """
                            curl -s -X POST -H 'Content-Type: application/json' \
                                -d '{"text":"${msg}","attachments":[{"color":"#FF0000","text":"${msg}"}]}' \
                                "${env.SLACK_WEBHOOK_URL}" || true
                        """
                    }
                }
            }
        }
        always {
            echo "Build completed"
        }
    }
}